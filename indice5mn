strategy("Mini Índice Pro - Região de Compra Blindada", shorttitle = "WIN_Filtro_Esticado", overlay = true, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, process_orders_on_close = true)

// =====================================================
// 1. HORÁRIO DE ENTRADA E ZERAGEM (B3: 09:15 - 16:15)
// =====================================================
bool use_time_filter = input.bool(true, "Filtrar por horário de entrada", group = "Horário de Operação")
int start_hour = input.int(9, "Hora Início", minval=0, maxval=23, group = "Horário de Operação")
int start_minute = input.int(15, "Minuto Início", minval=0, maxval=59, group = "Horário de Operação")
int end_hour = input.int(16, "Hora Fim (Limite Entradas)", minval=0, maxval=23, group = "Horário de Operação")
int end_minute = input.int(15, "Minuto Fim (Limite Entradas)", minval=0, maxval=59, group = "Horário de Operação")

int current_time_in_minutes = hour(time, "America/Sao_Paulo") * 60 + minute(time, "America/Sao_Paulo")
int start_time_in_minutes = start_hour * 60 + start_minute
int end_time_in_minutes = end_hour * 60 + end_minute

bool in_session = not use_time_filter or (current_time_in_minutes >= start_time_in_minutes and current_time_in_minutes <= end_time_in_minutes)
bool time_to_close = (hour(time, "America/Sao_Paulo") * 60 + minute(time, "America/Sao_Paulo")) >= (16 * 60 + 30)

// =====================================================
// 2. TENDÊNCIA, MÉDIAS E EMA WAVE
// =====================================================
int wave_len = input.int(34, "Período EMA Wave", minval = 1, group = "Parâmetros de Tendência")
int ema80_len = input.int(80, "EMA 80", minval = 1, group = "Parâmetros de Tendência")
int ema200_len = input.int(200, "EMA 200 (Macro)", minval = 1, group = "Parâmetros de Tendência")

float emaWaveHigh = ta.ema(high, wave_len)
float emaWaveClose = ta.ema(close, wave_len)
float emaWaveLow = ta.ema(low, wave_len)

float ema9 = ta.ema(close, 13)
float ema21 = ta.ema(close, 26)
float ema80 = ta.ema(close, ema80_len)
float ema200 = ta.ema(close, ema200_len)

// =====================================================
// 3. FILTROS ANTI-SOBRECOMPRA / PREÇO ESTICADO
// =====================================================
groupStretched = "Filtro Anti-Preço Esticado"
bool use_rsi_filter = input.bool(true, "Ativar Filtro RSI Max", group = groupStretched)
int rsi_max_allowed = input.int(65, "RSI Máximo para Compra", minval = 50, maxval = 90, group = groupStretched)
float rsi_val = ta.rsi(close, 14)
bool rsi_ok = not use_rsi_filter or (rsi_val <= rsi_max_allowed)

bool use_dist_filter = input.bool(true, "Ativar Filtro Distância EMA 80", group = groupStretched)
float max_dist_pts = input.float(350.0, "Distância Máxima da EMA 80 (Pts)", minval = 50.0, step = 25.0, group = groupStretched)
float current_dist_ema80 = math.abs(close - ema80)
bool dist_ok = not use_dist_filter or (current_dist_ema80 <= max_dist_pts)

// =====================================================
// 4. REGRA DE BLOQUEIO & LATERALIZAÇÃO
// =====================================================
bool inside_wave = close >= emaWaveLow and close <= emaWaveHigh
bool price_above_wave = close > emaWaveHigh

groupConsol = "Filtro de Lateralização & ADX"
bool use_consolidation_filter = input.bool(true, "Ativar Filtro de Lateralização", group = groupConsol)
int consolidation_lookback = input.int(20, "Barras para Analisar", minval = 1, group = groupConsol)
int max_allowed_crosses = input.int(4, "Limite de Cruzamentos", minval = 1, group = groupConsol)

bool ema_crossed_now = ta.cross(ema9, ema21)
float crosses_sum = math.sum(ema_crossed_now ? 1.0 : 0.0, consolidation_lookback)
bool is_consolidated = use_consolidation_filter and (bar_index >= consolidation_lookback) and (crosses_sum >= max_allowed_crosses)

bool use_adx_filter = input.bool(true, "Ativar Filtro ADX", group = groupConsol)
int adx_len = input.int(14, "Período ADX", minval = 1, group = groupConsol)
int adx_threshold = input.int(15, "ADX Mínimo", minval = 1, group = groupConsol)

[p_loc, m_loc, a_loc] = ta.dmi(adx_len, adx_len)
bool adx_bull = not use_adx_filter or (a_loc >= adx_threshold and p_loc > m_loc)

// =====================================================
// 5. GESTÃO DE RISCO (DAY TRADE)
// =====================================================
groupRisk = "Gestão de Risco & Stop"
float stop_pts = input.float(500.0, "Stop Loss Fixo (Pontos)", step = 50.0, group = groupRisk)
float take_pts = input.float(1000.0, "Take Profit (Pontos)", step = 100.0, group = groupRisk)

float max_daily_loss_pts = input.float(1500.0, "Limite de Perda Diária (Pontos)", minval = 100.0, step = 50.0, group = groupRisk)
strategy.risk.max_intraday_loss(max_daily_loss_pts, strategy.cash)

// =====================================================
// 6. GATILHOS DE ENTRADA (COMPRA RESTRITA)
// =====================================================
bool cross_wave_80 = ta.crossover(emaWaveClose, ema80)
bool buy_trigger = in_session and not is_consolidated and adx_bull and cross_wave_80 and price_above_wave and not inside_wave and rsi_ok and dist_ok

// =====================================================
// 7. EXECUÇÃO DE POSIÇÕES
// =====================================================
var float active_sl = na
var float active_tp = na

if buy_trigger and strategy.position_size == 0 and not time_to_close
    active_sl := close - stop_pts
    active_tp := close + take_pts
    strategy.entry("Compra DT", strategy.long, comment = "Compra Protegida")
    strategy.exit("Exit Long", from_entry = "Compra DT", stop = active_sl, limit = active_tp)

if time_to_close and strategy.position_size != 0
    strategy.close_all(comment = "Fim do Pregão (DT)")

if strategy.position_size == 0
    active_sl := na
    active_tp := na

// =====================================================
// 8. PLOTS VISUAIS E REGIÃO DE RISCO
// =====================================================
pHigh = plot(emaWaveHigh, color = color.new(color.green, 30), linewidth = 1, title = "Wave High")
pClose = plot(emaWaveClose, color = color.new(color.gray, 50), linewidth = 1, title = "Wave Close")
pLow = plot(emaWaveLow, color = color.new(color.red, 30), linewidth = 1, title = "Wave Low")
fill(pHigh, pLow, color = color.new(color.blue, 92), title = "Canal Wave")

plot(ema9, color = color.green, linewidth = 1, title = "EMA 13")
plot(ema21, color = color.red, linewidth = 1, title = "EMA 26")
plot(ema80, color = color.yellow, linewidth = 2, title = "EMA 80")
plot(ema200, color = color.orange, linewidth = 3, title = "EMA 200 (Macro)")

color bg_color = is_consolidated ? color.new(color.orange, 88) : (adx_bull ? color.new(color.green, 92) : color.new(color.gray, 96))
bgcolor(bg_color, title = "Fundo ADX e Lateralização")

plot(strategy.position_size != 0 ? active_sl : na, color = color.red, style = plot.style_linebr, linewidth = 2, title = "Stop Loss Fixo")
plot(strategy.position_size != 0 ? active_tp : na, color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2, title = "Take Profit")

plotshape(buy_trigger, title = "Sinal Compra", text = "COMPRA DT", location = location.belowbar, style = shape.labelup, size = size.small, color = color.green, textcolor = color.white)

if buy_trigger
    box.new(left = bar_index, top = close, right = bar_index + 4, bottom = close - stop_pts, 
            bgcolor = color.new(color.red, 85), 
            border_color = color.red, 
            border_style = line.style_dashed, 
            text = "Zona Stop 500p", 
            text_color = color.white, 
            text_size = size.small)
