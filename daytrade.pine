//@version=5
strategy("Forex Day Trade - ADX Dinâmico + RSI + Distância EMA 80",
     shorttitle="Forex_ADX_RSI_DistEMA80",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0,
     process_orders_on_close=true)

// =====================================================
// 1. HORÁRIO DE OPERAÇÃO
// =====================================================
bool use_time_filter = input.bool(true, "Filtrar por horário", group="Horário de Operação")
string sessao = input.session("0800-1700", "Janela operacional", group="Horário de Operação")

bool in_session = not use_time_filter or not na(time(timeframe.period, sessao))

// =====================================================
// 2. TENDÊNCIA E MÉDIAS
// =====================================================
int wave_len = input.int(34, "Período EMA Wave", minval=1, group="Parâmetros de Tendência")
int ema80_len = input.int(80, "EMA intermediária", minval=1, group="Parâmetros de Tendência")
int ema_macro_len = input.int(200, "EMA macro", minval=1, group="Parâmetros de Tendência")

float emaWaveHigh = ta.ema(high, wave_len)
float emaWaveClose = ta.ema(close, wave_len)
float emaWaveLow = ta.ema(low, wave_len)

float ema80 = ta.ema(close, ema80_len)
float ema200 = ta.ema(close, ema_macro_len)

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)

bool trend_bullish = ema80 > ema200
bool trend_bearish = ema80 < ema200

// =====================================================
// 3. ATR E GESTÃO DE RISCO
// =====================================================
int atr_len = input.int(14, "Período ATR", minval=1, group="Gestão de Risco")
float atr_mult_sl = input.float(1.5, "Multiplicador ATR do Stop", minval=0.1, step=0.1, group="Gestão de Risco")
float risk_reward = input.float(2.0, "Risco/Retorno", minval=0.1, step=0.1, group="Gestão de Risco")
float max_daily_loss_pct = input.float(5.0, "Limite de perda diária (% do patrimônio)", minval=0.1, maxval=100.0, step=0.1, group="Gestão de Risco")

float atr = ta.atr(atr_len)

strategy.risk.max_intraday_loss(max_daily_loss_pct, strategy.percent_of_equity)

// =====================================================
// 4. FILTRO DE DISTÂNCIA MÁXIMA DA EMA 80 (NOVO)
// =====================================================
bool use_dist_filter  = input.bool(true, "Ativar Filtro de Distância Máxima da EMA 80", group="Filtro de Estiramento (EMA 80)")
float max_ema80_dist  = input.float(2.5, "Distância Máxima (em múltiplos do ATR)", minval=0.5, step=0.1, group="Filtro de Estiramento (EMA 80)")

// Cálculo da distância absoluta entre o preço de fechamento e a EMA 80
float dist_from_ema80 = math.abs(close - ema80)
bool not_too_far_ema80 = not use_dist_filter or (dist_from_ema80 <= (atr * max_ema80_dist))

// =====================================================
// 5. FILTRO RSI
// =====================================================
bool use_rsi_filter = input.bool(true, "Ativar Filtro de RSI", group="Filtro RSI")
int rsi_len         = input.int(14, "Período RSI", minval=1, group="Filtro RSI")
int rsi_ob          = input.int(70, "Nível Máximo de Sobrecompra", minval=50, maxval=90, group="Filtro RSI")
int rsi_os          = input.int(30, "Nível Mínimo de Sobrevenda", minval=10, maxval=50, group="Filtro RSI")

float rsi_val       = ta.rsi(close, rsi_len)

bool rsi_buy_ok  = not use_rsi_filter or (rsi_val > 50 and rsi_val < rsi_ob)
bool rsi_sell_ok = not use_rsi_filter or (rsi_val < 50 and rsi_val > rsi_os)

// =====================================================
// 6. DETECÇÃO DINÂMICA DE TIMEFRAMES (CASCATA ADX)
// =====================================================
int adx_len = input.int(14, "Período ADX", minval=1, group="Filtro ADX MTF")
int adx_threshold = input.int(20, "ADX Mínimo", minval=1, group="Filtro ADX MTF")

string tf_med = "60"
string tf_mac = "240"

if timeframe.isseconds or (timeframe.isintraday and timeframe.multiplier <= 3)
    tf_med := "5"
    tf_mac := "15"
else if timeframe.isintraday and timeframe.multiplier <= 5
    tf_med := "15"
    tf_mac := "60"
else if timeframe.isintraday and timeframe.multiplier <= 15
    tf_med := "60"
    tf_mac := "240"
else if timeframe.isintraday and timeframe.multiplier <= 60
    tf_med := "240"
    tf_mac := "1D"
else
    tf_med := "240"
    tf_mac := "1D"

f_adx_status(_tf, _len, _thresh) =>
    [p, m, a] = request.security(syminfo.tickerid, _tf, ta.dmi(_len, _len), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    bool is_bull = (a[1] >= _thresh) and (p[1] > m[1])
    bool is_bear = (a[1] >= _thresh) and (m[1] > p[1])
    [is_bull, is_bear]

[adx_med_bull, adx_med_bear] = f_adx_status(tf_med, adx_len, adx_threshold)
[adx_mac_bull, adx_mac_bear] = f_adx_status(tf_mac, adx_len, adx_threshold)

[p_loc, m_loc, a_loc] = ta.dmi(adx_len, adx_len)
bool adx_loc_bull = (a_loc >= adx_threshold) and (p_loc > m_loc)
bool adx_loc_bear = (a_loc >= adx_threshold) and (m_loc > p_loc)

bool adx_all_bull = adx_loc_bull and adx_med_bull and adx_mac_bull
bool adx_all_bear = adx_loc_bear and adx_med_bear and adx_mac_bear
bool adx_weak     = a_loc < adx_threshold

// =====================================================
// 7. FILTRO DE LATERALIZAÇÃO
// =====================================================
bool use_consolidation_filter = input.bool(true, "Ativar filtro de lateralização", group="Filtro de Lateralização")
int consolidation_lookback = input.int(20, "Barras para analisar", minval=1, group="Filtro de Lateralização")
int max_allowed_crosses = input.int(3, "Limite de cruzamentos", minval=1, group="Filtro de Lateralização")

bool ema_crossed_now = ta.cross(ema9, ema21)
float crosses_sum = math.sum(ema_crossed_now ? 1.0 : 0.0, consolidation_lookback)

bool enough_cross_data = bar_index >= consolidation_lookback
bool momentum_breakout = math.abs(ema9 - ema21) > ta.atr(14) * 0.3 and not adx_weak
bool is_consolidated = use_consolidation_filter and enough_cross_data and (crosses_sum >= max_allowed_crosses) and not momentum_breakout

// =====================================================
// 8. VALIDAÇÃO E CONDIÇÕES DE PREÇO
// =====================================================
bool indicators_ready = not na(emaWaveHigh) and not na(emaWaveLow) and not na(ema80) and not na(ema200) and not na(atr) and atr > 0

bool can_trade = indicators_ready and not is_consolidated and in_session

bool price_above_emas = (close > ema80) and (close > ema200)
bool price_below_emas = (close < ema80) and (close < ema200)

// =====================================================
// 9. SINAIS DE ENTRADA (INCLUI O FILTRO NOT_TOO_FAR_EMA80)
// =====================================================
bool broke_wave_up     = ta.crossover(close, emaWaveHigh)
bool pullback_wave_u   = (close > emaWaveHigh) and (low <= emaWaveHigh) and (close > open)
bool strong_impulse_u  = (close > emaWaveHigh) and (close > ema9) and (ema9 > ema21) and (close > open)

bool wave_buy_action   = broke_wave_up or pullback_wave_u or strong_impulse_u

// Compra: Exige também que o preço NÃO esteja excessivamente distante da EMA 80
bool buy_trigger  = can_trade and trend_bullish and adx_all_bull and price_above_emas and (close > ema9) and wave_buy_action and rsi_buy_ok and not_too_far_ema80

bool broke_wave_down   = ta.crossunder(close, emaWaveLow)
bool pullback_wave_d   = (close < emaWaveLow) and (high >= emaWaveLow) and (close < open)
bool strong_impulse_d  = (close < emaWaveLow) and (close < ema9) and (ema9 < ema21) and (close < open)

bool wave_sell_action  = broke_wave_down or pullback_wave_d or strong_impulse_d

// Venda: Exige também que o preço NÃO esteja excessivamente distante da EMA 80
bool sell_trigger = can_trade and trend_bearish and adx_all_bear and price_below_emas and (close < ema9) and wave_sell_action and rsi_sell_ok and not_too_far_ema80

// =====================================================
// 10. EXECUÇÃO DE POSIÇÕES
// =====================================================
var float sl_price = na
var float tp_price = na

bool new_long = buy_trigger and strategy.position_size == 0
bool new_short = sell_trigger and strategy.position_size == 0

if new_long
    float structural_support = math.min(emaWaveLow, ema80)
    float proposed_sl = math.min(close - atr * atr_mult_sl, structural_support - atr * 0.2)
    float proposed_risk = close - proposed_sl

    if proposed_risk > syminfo.mintick
        sl_price := proposed_sl
        tp_price := close + proposed_risk * risk_reward
        strategy.entry("Long Pullback", strategy.long, comment="Compra ADX+RSI")
        strategy.exit("Exit Long", from_entry="Long Pullback", stop=sl_price, limit=tp_price)

if new_short
    float structural_resistance = math.max(emaWaveHigh, ema80)
    float proposed_sl = math.max(close + atr * atr_mult_sl, structural_resistance + atr * 0.2)
    float proposed_risk = proposed_sl - close

    if proposed_risk > syminfo.mintick
        sl_price := proposed_sl
        tp_price := close - proposed_risk * risk_reward
        strategy.entry("Short Pullback", strategy.short, comment="Venda ADX+RSI")
        strategy.exit("Exit Short", from_entry="Short Pullback", stop=sl_price, limit=tp_price)

if strategy.position_size > 0 and not na(sl_price) and not na(tp_price)
    strategy.exit("Exit Long", from_entry="Long Pullback", stop=sl_price, limit=tp_price)

if strategy.position_size < 0 and not na(sl_price) and not na(tp_price)
    strategy.exit("Exit Short", from_entry="Short Pullback", stop=sl_price, limit=tp_price)

// =====================================================
// 11. SAÍDA TÉCNICA PELA EMA WAVE
// =====================================================
if strategy.position_size > 0 and close < emaWaveClose
    strategy.close("Long Pullback", comment="Saída Wave Close")

if strategy.position_size < 0 and close > emaWaveClose
    strategy.close("Short Pullback", comment="Saída Wave Close")

bool position_just_closed = strategy.position_size == 0 and strategy.position_size[1] != 0

if position_just_closed
    sl_price := na
    tp_price := na

// =====================================================
// 12. PLOTS VISUAIS E BGCOLOR DINÂMICO
// =====================================================
pHigh = plot(emaWaveHigh, color=color.new(color.green, 30), linewidth=1, title="Wave High")
pClose = plot(emaWaveClose, color=color.new(color.gray, 50), linewidth=1, title="Wave Close")
pLow = plot(emaWaveLow, color=color.new(color.red, 30), linewidth=1, title="Wave Low")

fill(pHigh, pLow, color=color.new(color.blue, 92), title="Canal Wave")

plot(ema80, color=color.yellow, linewidth=2, title="EMA 80")
plot(ema200, color=color.orange, linewidth=2, title="EMA 200")
plot(ema9, color=color.rgb(0, 128, 11), title="EMA 9")

color bg_color = na
if is_consolidated or adx_weak
    bg_color := color.new(color.orange, 90) 
else if adx_all_bull
    bg_color := color.new(color.green, 92)  
else if adx_all_bear
    bg_color := color.new(color.red, 92)    
else
    bg_color := color.new(color.gray, 96)   

bgcolor(bg_color, title="Fundo ADX Dinâmico")

plot(strategy.position_size != 0 ? sl_price : na, color=color.red, style=plot.style_linebr, linewidth=2, title="Stop Loss")
plot(strategy.position_size != 0 ? tp_price : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Take Profit")

plotshape(new_long, title="Sinal Compra", text="COMPRA", location=location.belowbar, style=shape.labelup, size=size.small, color=color.green, textcolor=color.white)
plotshape(new_short, title="Sinal Venda", text="VENDA", location=location.abovebar, style=shape.labeldown, size=size.small, color=color.red, textcolor=color.white)

barcolor(adx_all_bull ? color.green : adx_all_bear ? color.red : color.gray)
