//@version=5
strategy("Forex Day Trade - Wave Pullback + MTF + ADX Bgcolor",
     shorttitle="Forex_Strategy_ADX",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0,
     process_orders_on_close=true)

// =====================================================
// 1. HORÁRIO DE OPERAÇÃO
// =====================================================
bool use_time_filter = input.bool(true, "Filtrar por horário", group="Horário de Operação")
string sessao = input.session("0800-1700", "Janela operacional", group="Horário de Operação")

bool in_session = not use_time_filter or not na(time(timeframe.period, sessao))

// =====================================================
// 2. TENDÊNCIA E MÉDIAS
// =====================================================
int wave_len = input.int(34, "Período EMA Wave", minval=1, group="Parâmetros de Tendência")
int ema80_len = input.int(80, "EMA intermediária", minval=1, group="Parâmetros de Tendência")
int ema_macro_len = input.int(200, "EMA macro", minval=1, group="Parâmetros de Tendência")

float emaWaveHigh = ta.ema(high, wave_len)
float emaWaveClose = ta.ema(close, wave_len)
float emaWaveLow = ta.ema(low, wave_len)

float ema80 = ta.ema(close, ema80_len)
float ema200 = ta.ema(close, ema_macro_len)

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)

bool trend_bullish = ema80 > ema200
bool trend_bearish = ema80 < ema200

// =====================================================
// 3. CÁLCULO E FILTRO DO ADX
// =====================================================
int adx_len = input.int(14, "Período ADX", minval=1, group="Filtro ADX")
int adx_threshold = input.int(20, "ADX Mínimo (Força de Tendência)", minval=1, group="Filtro ADX")

[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)

bool adx_strong_bull = (adx_val >= adx_threshold) and (di_plus > di_minus)
bool adx_strong_bear = (adx_val >= adx_threshold) and (di_minus > di_plus)
bool adx_weak        = adx_val < adx_threshold

// =====================================================
// 4. FILTRO MTF SEM USAR CANDLE MAIOR ABERTO
// =====================================================
bool use_htf_filter = input.bool(true, "Ativar filtro MTF", group="Filtro Macro (MTF)")
string htf_tf = input.timeframe("240", "Timeframe maior", group="Filtro Macro (MTF)")
int htf_ema_len = input.int(200, "Período EMA MTF", minval=1, group="Filtro Macro (MTF)")

[htf_ema, htf_ema_prev] = request.security(
     syminfo.tickerid,
     htf_tf,
     [ta.ema(close, htf_ema_len)[1], ta.ema(close, htf_ema_len)[2]],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)

bool htf_bullish = htf_ema > htf_ema_prev
bool htf_bearish = htf_ema < htf_ema_prev

bool mtf_buy_allowed = not use_htf_filter or htf_bullish
bool mtf_sell_allowed = not use_htf_filter or htf_bearish

// =====================================================
// 5. FILTRO DE LATERALIZAÇÃO
// =====================================================
bool use_consolidation_filter = input.bool(true, "Ativar filtro de lateralização", group="Filtro de Lateralização")
int consolidation_lookback = input.int(20, "Barras para analisar", minval=1, group="Filtro de Lateralização")
int max_allowed_crosses = input.int(3, "Limite de cruzamentos", minval=1, group="Filtro de Lateralização")

bool ema_crossed_now = ta.cross(ema9, ema21)
float crosses_sum = math.sum(ema_crossed_now ? 1.0 : 0.0, consolidation_lookback)

bool enough_cross_data = bar_index >= consolidation_lookback
bool is_consolidated = use_consolidation_filter and enough_cross_data and crosses_sum >= max_allowed_crosses
bool not_consolidated = not is_consolidated

// =====================================================
// 6. ATR E GESTÃO DE RISCO
// =====================================================
int atr_len = input.int(14, "Período ATR", minval=1, group="Gestão de Risco")
float atr_mult_sl = input.float(1.5, "Multiplicador ATR do Stop", minval=0.1, step=0.1, group="Gestão de Risco")
float risk_reward = input.float(2.0, "Risco/Retorno", minval=0.1, step=0.1, group="Gestão de Risco")
float max_daily_loss_pct = input.float(5.0, "Limite de perda diária (% do patrimônio)", minval=0.1, maxval=100.0, step=0.1, group="Gestão de Risco")

float atr = ta.atr(atr_len)

strategy.risk.max_intraday_loss(max_daily_loss_pct, strategy.percent_of_equity)

// =====================================================
// 7. VALIDAÇÃO DOS INDICADORES
// =====================================================
bool indicators_ready = not na(emaWaveHigh) and not na(emaWaveLow) and not na(emaWaveClose) and not na(ema80) and not na(ema200) and not na(atr) and atr > 0
bool htf_ready = not use_htf_filter or (not na(htf_ema) and not na(htf_ema_prev))

bool can_trade = indicators_ready and htf_ready and not is_consolidated and in_session and not adx_weak

// =====================================================
// 8. SINAIS DE ENTRADA (Wave Verde + EMA 9 + Pullback/Rompimento)
// =====================================================
bool broke_wave_up   = ta.crossover(close, emaWaveHigh)
bool pullback_wave_u = (close > emaWaveHigh) and (low <= emaWaveHigh) and (close > open)
bool wave_buy_action = broke_wave_up or pullback_wave_u

bool buy_trigger  = can_trade and trend_bullish and mtf_buy_allowed and (close > ema9) and wave_buy_action and adx_strong_bull

bool broke_wave_down = ta.crossunder(close, emaWaveLow)
bool pullback_wave_d = (close < emaWaveLow) and (high >= emaWaveLow) and (close < open)
bool wave_sell_action= broke_wave_down or pullback_wave_d

bool sell_trigger = can_trade and trend_bearish and mtf_sell_allowed and (close < ema9) and wave_sell_action and adx_strong_bear

// =====================================================
// 9. NÍVEIS DE STOP E ALVO
// =====================================================
var float sl_price = na
var float tp_price = na

bool new_long = buy_trigger and strategy.position_size == 0
bool new_short = sell_trigger and strategy.position_size == 0

if new_long
    float structural_support = math.min(emaWaveLow, ema80)
    float proposed_sl = math.min(close - atr * atr_mult_sl, structural_support - atr * 0.2)
    float proposed_risk = close - proposed_sl

    if proposed_risk > syminfo.mintick
        sl_price := proposed_sl
        tp_price := close + proposed_risk * risk_reward
        strategy.entry("Long Pullback", strategy.long, comment="Compra Wave + ADX")
        strategy.exit("Exit Long", from_entry="Long Pullback", stop=sl_price, limit=tp_price)

if new_short
    float structural_resistance = math.max(emaWaveHigh, ema80)
    float proposed_sl = math.max(close + atr * atr_mult_sl, structural_resistance + atr * 0.2)
    float proposed_risk = proposed_sl - close

    if proposed_risk > syminfo.mintick
        sl_price := proposed_sl
        tp_price := close - proposed_risk * risk_reward
        strategy.entry("Short Pullback", strategy.short, comment="Venda Wave + ADX")
        strategy.exit("Exit Short", from_entry="Short Pullback", stop=sl_price, limit=tp_price)

if strategy.position_size > 0 and not na(sl_price) and not na(tp_price)
    strategy.exit("Exit Long", from_entry="Long Pullback", stop=sl_price, limit=tp_price)

if strategy.position_size < 0 and not na(sl_price) and not na(tp_price)
    strategy.exit("Exit Short", from_entry="Short Pullback", stop=sl_price, limit=tp_price)

// =====================================================
// 10. SAÍDA TÉCNICA PELA EMA WAVE
// =====================================================
if strategy.position_size > 0 and close < emaWaveClose
    strategy.close("Long Pullback", comment="Saída Wave Close")

if strategy.position_size < 0 and close > emaWaveClose
    strategy.close("Short Pullback", comment="Saída Wave Close")

bool position_just_closed = strategy.position_size == 0 and strategy.position_size[1] != 0

if position_just_closed
    sl_price := na
    tp_price := na

// =====================================================
// 11. VISUALIZAÇÃO DO CANAL WAVE E MÉDIAS
// =====================================================
pHigh = plot(emaWaveHigh, color=color.new(color.green, 30), linewidth=1, title="Wave High")
pClose = plot(emaWaveClose, color=color.new(color.gray, 50), linewidth=1, title="Wave Close")
pLow = plot(emaWaveLow, color=color.new(color.red, 30), linewidth=1, title="Wave Low")

fill(pHigh, pLow, color=color.new(color.blue, 92), title="Canal Wave")

plot(ema80, color=color.yellow, linewidth=2, title="EMA 80")
plot(ema200, color=color.orange, linewidth=2, title="EMA 200")
plot(ema9, color=color.rgb(0, 128, 11), title="EMA 9")

// =====================================================
// 12. FUNDO COLORIDO CONFORME ADX E LATERALIZAÇÃO
// =====================================================
bool price_inside_wave = close >= emaWaveLow and close <= emaWaveHigh

color bg_color = na
if is_consolidated or adx_weak
    bg_color := color.new(color.orange, 88) // Laranja: Sem tendência / Lateral
else if adx_strong_bull
    bg_color := color.new(color.green, 93)  // Verde suave: Tendência Forte de Alta
else if adx_strong_bear
    bg_color := color.new(color.red, 93)    // Vermelho suave: Tendência Forte de Baixa
else if price_inside_wave
    bg_color := color.new(color.gray, 96)   // Cinza: Preço dentro da Wave

bgcolor(bg_color, title="Fundo ADX / Tendência")

plot(strategy.position_size != 0 ? sl_price : na, color=color.red, style=plot.style_linebr, linewidth=2, title="Stop Loss")
plot(strategy.position_size != 0 ? tp_price : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Take Profit")

// =====================================================
// 13. MARCADORES DOS SINAIS E VELAS
// =====================================================
plotshape(new_long, title="Sinal Compra", text="COMPRA", location=location.belowbar, style=shape.labelup, size=size.small, color=color.green, textcolor=color.white)
plotshape(new_short, title="Sinal Venda", text="VENDA", location=location.abovebar, style=shape.labeldown, size=size.small, color=color.red, textcolor=color.white)
barcolor(trend_bullish ? color.green : trend_bearish ? color.red : color.blue)
